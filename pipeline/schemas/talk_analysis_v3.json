{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Talk analysis V3",
  "description": "V3: reconstruct the speaker's intent and skeleton first, then a lean set of fields that each feed a section of the final report. Prose in Chinese; quotes verbatim in the transcript's language. Numbers come from speech recognition and are unverified: record which metric a speaker tracks, not its value.",
  "type": "object",
  "required": [
    "talk_id",
    "speakers",
    "org",
    "value_chain_layer",
    "position",
    "target_customer",
    "intent",
    "skeleton",
    "core_message",
    "frameworks",
    "offerings",
    "why_needed",
    "problem_approach",
    "non_consensus",
    "signals",
    "trend_categories",
    "novelty",
    "pr_level",
    "content_industry_note",
    "filtered_consensus"
  ],
  "additionalProperties": false,
  "properties": {
    "talk_id": {
      "type": "string",
      "description": "Must match data/01_talks.csv.",
      "pattern": "\\S"
    },
    "speakers": {
      "type": "string",
      "description": "",
      "pattern": "\\S"
    },
    "org": {
      "type": "string",
      "description": "",
      "pattern": "\\S"
    },
    "value_chain_layer": {
      "$ref": "#/$defs/value_chain_layer"
    },
    "position": {
      "type": "string",
      "description": "A short description of the specific position.",
      "pattern": "\\S"
    },
    "target_customer": {
      "$ref": "#/$defs/target_customer"
    },
    "intent": {
      "$ref": "#/$defs/intent"
    },
    "skeleton": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {
        "type": "string",
        "description": "One main point, in presentation order.",
        "pattern": "\\S"
      }
    },
    "core_message": {
      "type": "string",
      "description": "One or two Chinese sentences.",
      "pattern": "\\S"
    },
    "frameworks": {
      "type": "array",
      "minItems": 0,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": [
          "name",
          "gist",
          "seg"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "description": "",
            "pattern": "\\S"
          },
          "gist": {
            "type": "string",
            "description": "",
            "pattern": "\\S"
          },
          "seg": {
            "$ref": "#/$defs/segment_range"
          }
        }
      }
    },
    "offerings": {
      "type": "array",
      "minItems": 0,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "name",
          "what",
          "for_whom",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "description": "",
            "pattern": "\\S"
          },
          "what": {
            "type": "string",
            "description": "",
            "pattern": "\\S"
          },
          "for_whom": {
            "type": "string",
            "description": "",
            "pattern": "\\S"
          },
          "status": {
            "$ref": "#/$defs/offering_status"
          }
        }
      }
    },
    "why_needed": {
      "type": "string",
      "description": "Name existing alternatives and explain why this is needed; may be empty."
    },
    "problem_approach": {
      "type": "array",
      "minItems": 0,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": [
          "problem",
          "approach"
        ],
        "additionalProperties": false,
        "properties": {
          "problem": {
            "type": "string",
            "description": "",
            "pattern": "\\S"
          },
          "approach": {
            "type": "string",
            "description": "",
            "pattern": "\\S"
          }
        }
      }
    },
    "non_consensus": {
      "type": "array",
      "minItems": 0,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "point",
          "quote",
          "seg"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "$ref": "#/$defs/nc_kind"
          },
          "point": {
            "type": "string",
            "description": "",
            "pattern": "\\S"
          },
          "quote": {
            "type": "string",
            "description": "Verbatim transcript text.",
            "pattern": "\\S"
          },
          "seg": {
            "$ref": "#/$defs/segment_range"
          },
          "speaker": {
            "type": "string",
            "description": "Required for panels or multiple speakers; optional otherwise."
          }
        }
      }
    },
    "signals": {
      "type": "array",
      "minItems": 0,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "type",
          "signal",
          "value_as_heard",
          "seg"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "$ref": "#/$defs/signal_type"
          },
          "signal": {
            "type": "string",
            "description": "",
            "pattern": "\\S"
          },
          "value_as_heard": {
            "type": "string",
            "description": "Unverified ASR number for reference; may be empty."
          },
          "seg": {
            "$ref": "#/$defs/segment_range"
          }
        }
      }
    },
    "trend_categories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/trend_category"
          },
          {
            "type": "string",
            "pattern": "^new:\\S.*$"
          }
        ]
      }
    },
    "novelty": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "pr_level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "content_industry_note": {
      "type": "string",
      "description": "Specific implication for content creators or platforms; may be empty."
    },
    "filtered_consensus": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": {
        "type": "string",
        "description": "",
        "pattern": "\\S"
      }
    }
  },
  "enums": {
    "value_chain_layer": {
      "foundation_model": "基座模型",
      "model_infra": "模型训练与推理服务",
      "agent_infra": "Agent 基础设施（sandbox、harness、gateway、可观测、agent 平台）",
      "data_context": "数据与上下文（搜索、记忆、数据库、数据供给）",
      "evaluation": "评测",
      "general_agent_app": "通用 / 个人 Agent 应用",
      "vertical_app": "垂直与企业应用",
      "ai_adopter": "AI 使用方（主业不卖 AI 的企业）",
      "embodied_world_model": "具身智能与世界模型 / 3D",
      "on_device": "端侧模型与推理",
      "capital_community": "资本与社区"
    },
    "target_customer": {
      "developer": "开发者",
      "enterprise": "企业",
      "model_lab": "模型公司",
      "consumer": "消费者 / 创作者",
      "internal": "内部使用（不对外卖）",
      "n/a": "不适用"
    },
    "intent": {
      "product": "推产品 / 服务",
      "insight": "分享认知 / 实践",
      "both": "两者"
    },
    "offering_status": {
      "launched": "已上线",
      "open_source": "开源",
      "preview": "预览 / 内测",
      "service": "服务 / 合作模式",
      "internal": "内部工具"
    },
    "nc_kind": {
      "insight": "认知",
      "practice": "实践做法",
      "prediction": "预测",
      "market_call": "市场 / 投资判断"
    },
    "trend_category": {
      "agent_harness_runtime": "Agent harness / 运行时与沙箱",
      "open_models_posttrain_inference": "开源模型与后训练 / 推理工程",
      "eval_verifiability": "评测与可验证性",
      "enterprise_agent_ops": "企业级 agent 规模化运营",
      "memory_data_context": "记忆、数据与上下文工程",
      "personal_agent_ai_native": "个人 agent 与 AI 原生产品",
      "world_model_spatial": "世界模型与空间智能",
      "embodied_physical_ai": "具身 / Physical AI",
      "on_device_decision_models": "端侧与决策模型",
      "investment_startup": "投资与创业叙事"
    },
    "signal_type": {
      "data_signal": "数据信号：谁在采集/生产/购买/出售什么数据",
      "metric_focus": "关注的指标：讲者在追踪/优化哪个指标，以及这说明他在意什么",
      "market_pattern": "市场格局 / 规律：谁在买什么、商业模式变化、竞争关系、行业分工等定性现象",
      "launch": "发布 / 开源"
    }
  },
  "$defs": {
    "value_chain_layer": {
      "type": "string",
      "enum": [
        "foundation_model",
        "model_infra",
        "agent_infra",
        "data_context",
        "evaluation",
        "general_agent_app",
        "vertical_app",
        "ai_adopter",
        "embodied_world_model",
        "on_device",
        "capital_community"
      ]
    },
    "target_customer": {
      "type": "string",
      "enum": [
        "developer",
        "enterprise",
        "model_lab",
        "consumer",
        "internal",
        "n/a"
      ]
    },
    "intent": {
      "type": "string",
      "enum": [
        "product",
        "insight",
        "both"
      ]
    },
    "offering_status": {
      "type": "string",
      "enum": [
        "launched",
        "open_source",
        "preview",
        "service",
        "internal"
      ]
    },
    "nc_kind": {
      "type": "string",
      "enum": [
        "insight",
        "practice",
        "prediction",
        "market_call"
      ]
    },
    "trend_category": {
      "type": "string",
      "enum": [
        "agent_harness_runtime",
        "open_models_posttrain_inference",
        "eval_verifiability",
        "enterprise_agent_ops",
        "memory_data_context",
        "personal_agent_ai_native",
        "world_model_spatial",
        "embodied_physical_ai",
        "on_device_decision_models",
        "investment_startup"
      ]
    },
    "signal_type": {
      "type": "string",
      "enum": [
        "data_signal",
        "metric_focus",
        "market_pattern",
        "launch"
      ]
    },
    "segment_range": {
      "type": "string",
      "pattern": "^\\d+(?:\\s*[–-]\\s*\\d+)?$",
      "description": "Source segment order or inclusive range; must be ordered and supported by the transcript."
    }
  }
}
